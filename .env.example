# MediCard runtime settings (all optional). Copy to .env or export them. Never commit real secrets.
# MEDICARD_DB_PATH=data/medicard.db
# MEDICARD_SECRET=change-me-to-a-long-random-string   # unset => random per process (tokens reset on restart)
# MEDICARD_TOKEN_TTL_HOURS=12
# MEDICARD_SEED=true
# MEDICARD_HOST=127.0.0.1
# MEDICARD_PORT=8000
# MEDICARD_LOG_LEVEL=INFO
# MEDICARD_FRONTEND_DIST=frontend/dist
