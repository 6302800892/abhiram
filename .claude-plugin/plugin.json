    "./.claude/agents/medicard-settlement-agent.md",
    "./.claude/agents/medicard-state-machine-validator-agent.md",
    "./.claude/agents/medicard-archtest-author-agent.md",
    "./.claude/agents/medicard-audit-tracer-agent.md",
    "./.claude/agents/medicard-janitor-agent.md",
    "./.claude/agents/medicard-doc-writer-agent.md"
  ],
  "skills": [
    "./.claude/skills/eligibility-resolver",
    "./.claude/skills/pre-auth-auto-decider",
